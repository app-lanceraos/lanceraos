# .env.example
# Backend environment (Django/Celery). Copy to .env for local dev; in production
# set these as Railway service variables (see DEPLOYMENT.md for the per-service
# table). Every variable below is read by config/settings.py or core/ — none are
# aspirational. Frontend (Vite) variables live in frontend/.env.example instead:
# Vite reads frontend/.env, not this file.
#
# Each entry shows the LOCAL value, with the PRODUCTION value in a comment.

# ── Django Core ────────────────────────────────────────────
# >= 50 characters or settings.py refuses to start. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# True only for local development. Production MUST be False: it switches on
# SSL redirect, HSTS, secure proxy header handling and WhiteNoise-only static.
DEBUG=True

# Comma-separated Host headers Django will answer to.
# Production: ALLOWED_HOSTS=api.lanceraos.com,healthcheck.railway.app
# (healthcheck.railway.app is the Host Railway's health probe sends; without it
# Django answers the probe with 400 and the deploy is marked failed.)
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database (PostgreSQL) ────────────────────────────────────
# Production (Railway Postgres reference variables):
#   DB_NAME=${{Postgres.PGDATABASE}}  DB_USER=${{Postgres.PGUSER}}
#   DB_PASSWORD=${{Postgres.PGPASSWORD}}  DB_HOST=${{Postgres.PGHOST}}  DB_PORT=${{Postgres.PGPORT}}
DB_NAME=lanceraos
DB_USER=lanceraos_user
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# ── Frontend URL ─────────────────────────────────────────────
# Used to build every client-facing link (invoice view, payment page, portal
# magic link, password-reset email).
# Production: FRONTEND_URL=https://lanceraos.com
FRONTEND_URL=http://localhost:5173

# ── Cookies ──────────────────────────────────────────────────
# Shared by frontend and backend so the httpOnly JWT/CSRF cookies are sent to
# both lanceraos.com and api.lanceraos.com. Local dev: leave empty (host-only).
# Production: COOKIE_DOMAIN=.lanceraos.com
COOKIE_DOMAIN=
# Production: COOKIE_SECURE=True (defaults to True whenever DEBUG=False)
COOKIE_SECURE=False
COOKIE_SAMESITE=Lax

# ── CORS / CSRF ──────────────────────────────────────────────
# Full origins (scheme + host [+ port]), no trailing slash. CORS_ALLOWED_ORIGINS
# is ALSO what the WebSocket OriginValidator (config/asgi.py) accepts.
# Production: CORS_ALLOWED_ORIGINS=https://lanceraos.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Production: CSRF_TRUSTED_ORIGINS=https://lanceraos.com
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── HTTPS hardening (only applied when DEBUG=False) ──────────
# HSTS max-age in seconds. Defaults to 3600 (1 hour) so a first deploy cannot
# lock a mistake into browsers for a year. Raise in steps — see DEPLOYMENT.md
# "Raising HSTS" (3600 -> 86400 -> 2592000 -> 31536000).
# SECURE_HSTS_SECONDS=3600
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# Preload is effectively irreversible; leave False until HSTS has run at one
# year for a while.
# SECURE_HSTS_PRELOAD=False

# ── Inbound email-reply webhook ──────────────────────────────
# Shared secret the Cloudflare Email Worker sends as X-Webhook-Secret to
# POST /api/invoices/email/incoming/. Unset => the endpoint rejects everything.
CLOUDFLARE_WEBHOOK_SECRET=

# ── Email (Resend HTTP API — core/email.py) ──────────────────
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=LanceraOS <noreply@lanceraos.com>
RESEND_FROM_NAME=LanceraOS

# ── Encryption (core/encryption.py) ──────────────────────────
# Fernet key — reversible encryption for CNIC/NTN/PSEB and custom SMTP
# passwords. LOSING OR ROTATING THIS MAKES EXISTING ENCRYPTED DATA UNREADABLE.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# HMAC key for the one-way CNIC/NTN/PSEB uniqueness index. Never reuse
# ENCRYPTION_KEY here (opposite security properties). Same loss warning.
#   python -c "import secrets; print(secrets.token_hex(32))"
BLIND_INDEX_KEY=

# ── OAuth ────────────────────────────────────────────────────
# Must match the frontend's VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
# Facebook app not created yet — leave blank; apps/users/oauth/facebook.py
# fails predictably until set.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ── Cloudinary (logo/signature/PDF/attachment storage) ───────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Redis (cache + Celery broker/result + Channels layer) ────
# Use SEPARATE logical databases (/0 /1 /2): the cache and the Celery broker
# would otherwise share keyspace, and a cache.clear() would flush the task
# queue. Production (Railway Redis reference variable):
#   REDIS_URL=${{Redis.REDIS_URL}}/1
#   CELERY_BROKER_URL=${{Redis.REDIS_URL}}/0   CELERY_RESULT_BACKEND=${{Redis.REDIS_URL}}/0
#   CHANNEL_LAYER_URL=${{Redis.REDIS_URL}}/2
REDIS_URL=redis://127.0.0.1:6379/1
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
CHANNEL_LAYER_URL=redis://127.0.0.1:6379/2

# ── AI (Groq) ────────────────────────────────────────────────
GROQ_API_KEY=
# Optional model overrides (defaults live in config/settings.py).
GROQ_MODEL_FAST=
GROQ_MODEL_QUALITY=
GROQ_MODEL_VISION=
# Dashboard insights card's AI. OFF by default (the card then shows fixed sentences built from the same facts):
# the pre-registered evaluation did not clear its manual read, see AI_EVALUATION.md section 14. Set True to switch it on.
# DASHBOARD_INSIGHTS_AI_ENABLED=False

# ── Observability ────────────────────────────────────────────
# Read into settings.SENTRY_DSN but NOTHING initialises Sentry yet
# (sentry-sdk is not installed). Setting it currently has no effect.
SENTRY_DSN=

# Not here on purpose: EXCHANGE_RATE_API_KEY (the rate fetcher,
# apps/payments/tasks.py, uses keyless open.er-api.com) and BACKEND_URL
# (removed 18 August 2026) — neither is read by any code.
