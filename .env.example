# .env.example
# Copy to .env and fill in. Every var below is read somewhere in
# core/ or apps/users/ — none are aspirational.

# ── Django Core ────────────────────────────────────────────
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

DEBUG=True

# Comma-separated. Add your production domain(s) before deploying.
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database (PostgreSQL) ────────────────────────────────────
DB_NAME=lanceraos
DB_USER=lanceraos_user
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# ── Frontend / Cookies ──────────────────────────────────────
FRONTEND_URL=http://localhost:5173
# Production: FRONTEND_URL=https://app.lanceraos.com
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# COOKIE_DOMAIN must be shared by frontend and backend for the
# httpOnly JWT/CSRF cookies to work. Local dev: leave unset (host-only
# cookie). Production: COOKIE_DOMAIN=.lanceraos.com (app.lanceraos.com +
# api.lanceraos.com share this).
COOKIE_DOMAIN=
COOKIE_SECURE=False
# Production: COOKIE_SECURE=True
COOKIE_SAMESITE=Lax

# ── CORS / CSRF ──────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Production: CORS_ALLOWED_ORIGINS=https://app.lanceraos.com
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Production: CSRF_TRUSTED_ORIGINS=https://app.lanceraos.com

# ── Email (Resend HTTP API — core/email.py) ─────────────────
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=LanceraOS <noreply@lanceraos.com>
RESEND_FROM_NAME=LanceraOS

# ── Encryption (core/encryption.py) ──────────────────────────
# Fernet key — reversible encryption for CNIC/NTN/PSEB and custom SMTP
# passwords. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Blind-index key — separate secret from ENCRYPTION_KEY, deliberately.
# HMAC key for the one-way CNIC/NTN/PSEB uniqueness index. Never reuse
# ENCRYPTION_KEY here — they have opposite security properties
# (randomized vs. deterministic) on purpose. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
BLIND_INDEX_KEY=

# ── OAuth ────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
# Facebook app not yet created — leave blank until it exists.
# apps/users/oauth/facebook.py fails predictably (not a crash) until set.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ── Cloudinary (profile/business logo uploads) ──────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Redis (cache + Celery broker/result backend) ────────────
REDIS_URL=redis://127.0.0.1:6379/1
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
CHANNEL_LAYER_URL=redis://127.0.0.1:6379/2

# ── AI (Groq) — not used by apps.users; reserved for future modules ──
GROQ_API_KEY=

# ── Currency — not used by apps.users; reserved for the payments module ──
EXCHANGE_RATE_API_KEY=

# ── Observability ────────────────────────────────────────────
SENTRY_DSN=
