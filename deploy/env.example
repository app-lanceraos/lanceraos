# deploy/env.example
#
# Template for deploy/.env (the REAL file; gitignored, never commit it).
#   cp env.example .env     (run inside deploy/)
# then replace every CHANGE_ME. Rules for this file format:
#   - one KEY=value per line, no spaces around "="
#   - no inline "# comments" after a value; comments go on their own line
#   - never use "$" in a value (Compose treats it as a variable). The commands
#     below only print safe characters.
#
# Generate secrets (run on any machine with python3; paste into your password
# manager FIRST - losing ENCRYPTION_KEY or BLIND_INDEX_KEY is unrecoverable):
#   SECRET_KEY / DB_PASSWORD / CLOUDFLARE_WEBHOOK_SECRET:
#     python3 -c "import secrets; print(secrets.token_urlsafe(64))"
#   ENCRYPTION_KEY (a Fernet key is just 32 random bytes in url-safe base64):
#     python3 -c "import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
#   BLIND_INDEX_KEY:
#     python3 -c "import secrets; print(secrets.token_hex(32))"
#
# ENCRYPTION_KEY and BLIND_INDEX_KEY must NEVER change once a real user has
# saved a CNIC/NTN/PSEB number or SMTP password, and the same values must
# follow the database when it moves to Railway later.

# ── Compose plumbing (not read by Django) ─────────────────────
# Which file the containers load. Leave as is for the real stack.
APP_ENV_FILE=.env
# Host port on 127.0.0.1 only (never exposed to the network).
WEB_PORT=8000
# Image tag shared by web/worker/beat/migrate.
IMAGE_TAG=local
# Start the Cloudflare Tunnel automatically with a plain `docker compose up -d`.
# Remove this line (or leave the token blank) to run without the tunnel.
COMPOSE_PROFILES=tunnel
# Distinct from the throwaway test stack ("lanceraos-test"): own volumes.
COMPOSE_PROJECT_NAME=lanceraos
# From Cloudflare dashboard > Networking > Tunnels > your tunnel (Docker).
TUNNEL_TOKEN=CHANGE_ME

# ── Django core ────────────────────────────────────────────────
SECRET_KEY=CHANGE_ME
DEBUG=False
ALLOWED_HOSTS=api.lanceraos.com,localhost,127.0.0.1
FRONTEND_URL=https://lanceraos.com

# ── Database (Postgres container; also used as POSTGRES_* by the db service) ──
DB_NAME=lanceraos
DB_USER=lanceraos
DB_PASSWORD=CHANGE_ME
DB_HOST=db
DB_PORT=5432

# ── Redis (one container, three logical databases) ────────────
REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CHANNEL_LAYER_URL=redis://redis:6379/2

# ── Cookies / CORS / CSRF (frontend lanceraos.com, API api.lanceraos.com) ──
COOKIE_DOMAIN=.lanceraos.com
COOKIE_SECURE=True
COOKIE_SAMESITE=Lax
CORS_ALLOWED_ORIGINS=https://lanceraos.com
CSRF_TRUSTED_ORIGINS=https://lanceraos.com

# ── HTTPS hardening (only applied when DEBUG=False) ───────────
# Low on purpose; raise in steps per DEPLOYMENT.md section 10.
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False

# ── Encryption ────────────────────────────────────────────────
ENCRYPTION_KEY=CHANGE_ME
BLIND_INDEX_KEY=CHANGE_ME

# ── Email (Resend) ────────────────────────────────────────────
RESEND_API_KEY=CHANGE_ME
DEFAULT_FROM_EMAIL=LanceraOS <noreply@lanceraos.com>
RESEND_FROM_NAME=LanceraOS
# Shared secret the inbound-reply Cloudflare Worker sends in X-Webhook-Secret.
CLOUDFLARE_WEBHOOK_SECRET=CHANGE_ME

# ── Third-party services ──────────────────────────────────────
GOOGLE_CLIENT_ID=CHANGE_ME
CLOUDINARY_CLOUD_NAME=CHANGE_ME
CLOUDINARY_API_KEY=CHANGE_ME
CLOUDINARY_API_SECRET=CHANGE_ME
GROQ_API_KEY=CHANGE_ME
# GROQ_MODEL_FAST / _QUALITY / _VISION are optional overrides; the defaults in
# config/settings.py are live-verified, so they are consciously omitted here.

# ── Observability ─────────────────────────────────────────────
# Read by settings.py but nothing initialises Sentry yet (sentry-sdk is not
# installed); leave blank.
SENTRY_DSN=
