# frontend/.env.example
# Build-time values for Vite (set these in Vercel > Project > Settings >
# Environment Variables for production; copy to frontend/.env for local dev).
# VITE_* values are compiled into the public JS bundle: never put a secret here.

# Backend base URL WITHOUT /api (src/lib/api.js appends it).
# Production: https://api.lanceraos.com
VITE_API_URL=http://localhost:8000

# WebSocket base URL (src/hooks/useWebSocket.js appends /ws/... paths).
# Production MUST be wss://, not ws:// (an https page blocks mixed content).
# Production: wss://api.lanceraos.com
VITE_WS_URL=ws://localhost:8000

# Google Sign-In OAuth client ID (public by design). Leave blank to disable.
VITE_GOOGLE_CLIENT_ID=
