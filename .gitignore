# Environment variables — never commit secrets
.env
.env.local
.env.production
.env.*.local

# Python virtual environment
venv/
env/
.venv/

# Python cache files
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# Django specific
*.log
db.sqlite3
media/
staticfiles/

# Real-data backups (Template Builder 2.0 Phase 0's export_invoice_designs_backup
# command writes here by default) — contains real user design/business data,
# never commit
backups/

# Celery
celerybeat-schedule
celerybeat.pid
celerybeat-schedule-shm
celerybeat-schedule-wal

# macOS system files
.DS_Store
.AppleDouble
.LSOverride

# VS Code
.vscode/
*.code-workspace

# Node
node_modules/
npm-debug.log*

# React build output
frontend/dist/
frontend/build/

# Coverage reports
htmlcov/
.coverage
coverage.xml

# pytest
.pytest_cache/

# MyPy
.mypy_cache/

v1-reference/

# Backend test suites — untracked deliberately to stay under claude.ai's
# GitHub-sync file-count limit (not a normal practice; these still exist
# and run locally/in CI from disk, just no longer pushed to GitHub).
apps/*/tests/
core/tests/

# Frontend test files (colocated *.test.jsx/*.test.js, not a separate
# folder) — same reason as the backend test suites above.
frontend/**/*.test.jsx
frontend/**/*.test.js